# Copy to .env before starting the stack.
# Create a free LiveKit Cloud project: https://cloud.livekit.io
# Inference (STT/LLM/TTS) is included — OPENAI_API_KEY is optional.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional. If set, the agent uses OpenAI plugins instead of LiveKit Inference.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

API_PORT=3001
API_BASE_URL=http://localhost:3001
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

VITE_API_URL=
